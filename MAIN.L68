0000108A  =00000002                145  KEYBOARD_MSK_UP EQU     %00000010
0000108A  =00000004                146  KEYBOARD_MSK_RG EQU     %00000100
0000108A  =00000008                147  KEYBOARD_MSK_DW EQU     %00001000
